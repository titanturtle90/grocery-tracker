// Reference Firestore rules for Grocery Glance.
// Paste into Firebase console → Firestore → Rules. The app is a personal,
// unauthenticated PWA, so each collection it uses needs read/write access.
// Tighten with Firebase Auth later if you ever share the URL.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /groceryItems/{id}     { allow read, write: if true; }
    match /shoppingList/{id}     { allow read, write: if true; }
    match /bogoItems/{id}        { allow read, write: if true; }
    match /recipeFavorites/{id}  { allow read, write: if true; }
    match /meta/{id}             { allow read, write: if true; }
  }
}
